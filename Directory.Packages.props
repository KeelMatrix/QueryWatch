<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="KeelMatrix.QueryWatch" Version="[0.1.0]" />
    <PackageVersion Include="KeelMatrix.QueryWatch.EfCore" Version="[0.1.0]" />
    <PackageVersion Include="KeelMatrix.Redaction" Version="[0.1.0]" />
    <PackageVersion Include="KeelMatrix.Telemetry" Version="[0.1.0]" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="xunit" Version="2.7.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.29" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />

    <!-- Security floors for transitive .NET and authentication dependencies. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageVersion Include="Azure.Identity" Version="1.11.4" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.61.3" />

    <!-- Keep SQLite test coverage while requiring SQLite 3.50.2 or newer. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
	<PackageVersion Include="Dapper" Version="2.1.35" />
	<PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />
	<PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.0" />
	<PackageVersion Include="Npgsql" Version="8.0.3" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
	<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageVersion Include="MySqlConnector" Version="2.3.6" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
  </ItemGroup>
</Project>
